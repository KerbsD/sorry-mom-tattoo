# Origin of the public smt-be API used for server-side portfolio and catalog
# fetches. The landing page never calls this from the browser, so it does not
# need CORS. Copy this file to `.env.local` for local development.
#
# Local: smt-be running on port 3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Production: set the same variable in your host's environment settings
# (e.g. Vercel -> Project Settings -> Environment Variables) to the deployed
# API origin, for example:
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
