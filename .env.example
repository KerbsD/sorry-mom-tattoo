# Origin of the public smt-be API. Catalog reads happen server-side, while
# booking creation and availability reads happen in the browser, so the landing
# origin must also be listed in the API's CORS_ORIGINS setting.
#
# Local: smt-be running on port 3000 and the landing on port 3002
NEXT_PUBLIC_API_URL=http://localhost:3000

# Production: set the same variable in your host's environment settings
# (e.g. Vercel -> Project Settings -> Environment Variables) to the deployed
# API origin, for example:
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
#
# Then add the deployed landing origin to the API's CORS_ORIGINS, for example:
# CORS_ORIGINS=https://admin.your-domain.com,https://your-domain.com
